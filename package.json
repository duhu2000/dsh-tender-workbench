{
  "name": "dsh-tender-workbench",
  "version": "0.3.0-beta.0",
  "description": "Open-source DeepSeek Harness tender Agent workbench with a Session-scoped end-to-end workflow",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "tender",
    "bidding",
    "procurement",
    "proposed-projects"
  ],
  "author": "Sunhh3221",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsdown --config tsdown.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunhh3221/dsh-tender-workbench.git"
  },
  "homepage": "https://github.com/Sunhh3221/dsh-tender-workbench#readme",
  "bugs": {
    "url": "https://github.com/Sunhh3221/dsh-tender-workbench/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "dependencies": {
    "@embedpdf/fonts-sc": "1.0.0",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2 || >=0.1.2-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 || >=0.1.2-0",
    "dsh-better-sidebar": ">=0.17.1 || >=0.18.0-0",
    "dsh-mcp-connector": ">=0.2.31"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "0.17.6",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "dsh-better-sidebar": "0.17.1",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
